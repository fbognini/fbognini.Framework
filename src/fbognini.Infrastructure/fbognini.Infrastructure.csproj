<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>fbognini.Infrastructure</PackageId>
    <Description>Persistence, multitenancy and repository implementations for fbognini projects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Snickler.EFCore" Version="3.0.0" />
    <PackageReference Include="FastIDs.TypeId.Serialization.SystemTextJson" Version="1.1.1" />
    <PackageReference Include="FastIDs.TypeId.Serialization.JsonNet" Version="1.1.1" />
    <PackageReference Include="MediatR" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="$(ExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Finbuckle.MultiTenant.AspNetCore" Version="9.4.12" />
    <PackageReference Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="9.4.12" />
    <PackageReference Include="EFCore.BulkExtensions" Version="8.1.3" />
    <PackageReference Include="linq2db.EntityFrameworkCore" Version="8.1.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Finbuckle.MultiTenant.AspNetCore" Version="10.1.3" />
    <PackageReference Include="Finbuckle.MultiTenant.EntityFrameworkCore" Version="10.1.3" />
    <PackageReference Include="EFCore.BulkExtensions" Version="10.0.1" />
    <PackageReference Include="linq2db.EntityFrameworkCore" Version="10.5.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Finbuckle 10 moved MultiTenantIdentityDbContext to its own package and no longer brings the EF Core Identity stores along. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(ExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fbognini.Core.Domain\fbognini.Core.Domain.csproj" />
  </ItemGroup>

</Project>
